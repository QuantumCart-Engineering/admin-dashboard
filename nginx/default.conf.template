# Rendered by the official nginx image entrypoint (20-envsubst-on-templates.sh).
# Only defined environment variables (e.g. ${API_GATEWAY_URL}) are substituted;
# nginx runtime variables such as $uri or $host are left untouched.

server {
    listen 80;
    server_name _;
    server_tokens off;

    root  /usr/share/nginx/html;
    index index.html;

    # The admin console is a private tool; keep it out of search engines.
    add_header X-Robots-Tag "noindex, nofollow" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Container / orchestrator health probe (used by the Docker HEALTHCHECK)
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Browser -> API Gateway proxy. The production build uses apiBaseUrl: '' so
    # every call is same-origin and lands here; /api/v1/... is forwarded
    # unchanged (the gateway itself enforces the ADMIN role).
    location ^~ /api/ {
        proxy_pass ${API_GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        client_max_body_size 6m;
    }

    # Fingerprinted / static assets: a missing file must return 404 instead of
    # falling back to index.html (which would surface as a MIME type error).
    location ~* \.(?:js|mjs|css|map|png|jpe?g|gif|svg|ico|webp|avif|woff2?|ttf|eot|otf)$ {
        try_files $uri =404;
        expires 7d;
    }

    location /assets/ {
        try_files $uri =404;
    }

    # Angular SPA fallback: any other path renders the application shell and is
    # resolved client-side by the router.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
